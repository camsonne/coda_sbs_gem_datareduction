# gemfilter SIDIS - BigBite electron arm (rendered by deploy/coda/gemfilter_ctl render).
# @...@ fields are filled from gemfilter_sidis.env.  Do not edit the rendered copy.
db_dir = @GF_DB_DIR@
date = @GF_DB_DATE@
arm = bb
gem_tracker = bb.gem
gem_bank_tags = @GF_GEM_BANKS@
seed_source = fadc
calo = bb.sh
calo_ps = bb.ps
max_seeds = 4
no_seed = @GF_NO_SEED@
mode = @GF_BB_MODE@
road_width_scale = @GF_BB_ROAD_SCALE@
road_margin = 0.005
# used only when mode = track
min_layers = 3
min_layers_confident = 5
max_hits2d_track = 400
keep_margin_strips = 3
keep_track_tol = 0.004
