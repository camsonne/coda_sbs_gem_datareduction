# gemfilter_sidis.env - site configuration of the gemfilter ET stations for SBS SIDIS.
# Bash syntax.  Sourced by setup_gemfilter.sh, gemfilter_ctl, gemfilter_check and gf_rc_hook.sh.
# Copy to <prefix>/etc/gemfilter_sidis.env (install_gemfilter.sh does this once and never
# overwrites it) and edit the lines marked [SET] / [VERIFY].  Every value can be overridden
# from the environment (VAR=... gemfilter_ctl start).

# ---- master switch ---------------------------------------------------------------------
# 0 = run-control hook does nothing (events go EB -> ER unfiltered).  Fastest way to back out.
GF_ENABLE=${GF_ENABLE:-1}

# ---- CODA / ET -------------------------------------------------------------------------
GF_EXPID=${GF_EXPID:-${EXPID:-sbs}}
# [SET] name of the CODA EB (or PEB) component that creates the ET system the ER reads from.
GF_EB_NAME=${GF_EB_NAME:-EB1}
# CODA3 EMU default ET name is /tmp/<EXPID>_<EMU name>; [VERIFY] against the etName in the
# EB transport of the SIDIS configuration (jcedit).  At most 99 characters.
GF_ET_FILE=${GF_ET_FILE:-/tmp/${GF_EXPID}_${GF_EB_NAME}}
# Empty = local (shared memory, the filters must run on the EB host).  Remote = TCP, every
# event is copied over the network: only for tests.
GF_ET_HOST=${GF_ET_HOST:-}
GF_ET_PORT=${GF_ET_PORT:-}          # ET TCP server port (with GF_ET_HOST)
GF_ET_UDP_PORT=${GF_ET_UDP_PORT:-}  # ET UDP port, if the EB does not use the default
# [VERIFY] name of the station the ER attaches to (gf_et_status -f $GF_ET_FILE --station X
# while a run is active, or the ER's ET transport settings in jcedit).
GF_ER_STATION=${GF_ER_STATION:-ER1}

# ---- arms ------------------------------------------------------------------------------
# Stations are created in this order, one gemfilter_et process each, upstream of the ER.
# Strips a station's APV map does not know (the other arm) are always kept, so the order
# only matters for CPU (put the arm with more reduction first).
GF_ARMS=${GF_ARMS:-"bb sbs"}
GF_STATION_PREFIX=${GF_STATION_PREFIX:-GEMFILTER_}   # -> GEMFILTER_BB, GEMFILTER_SBS

# ---- database / filter configuration ---------------------------------------------------
# [SET] SBS-replay DB.  No SIDIS DB exists yet (Oct 2026): GF_DB_DATE selects the subdir.
# 2023-06-01 = GEn-II BigBite layout (DB/20220701); change when the SIDIS DB is committed.
GF_DB_DIR=${GF_DB_DIR:-/group/halla/parity/software/SBS-replay/DB}
GF_DB_DATE=${GF_DB_DATE:-"2023-06-01 00:00:00"}
GF_GEM_BANKS=${GF_GEM_BANKS:-3561}
GF_NO_SEED=${GF_NO_SEED:-keep}          # keep | drop | global  (keep = never lose an event)
GF_BB_MODE=${GF_BB_MODE:-road}          # road (lossless vs SBS-offline) | track
GF_BB_ROAD_SCALE=${GF_BB_ROAD_SCALE:-1.0}
GF_SBS_TRACKER=${GF_SBS_TRACKER:-sbs.gem}  # [VERIFY] SIDIS SBS-arm tracker prefix in the DB
GF_SBS_SEED=${GF_SBS_SEED:-fadc}        # fadc (HCal FADC250) | vtp (HCal VTP clusters)
GF_SBS_VTP_ROC=${GF_SBS_VTP_ROC:-30}
GF_SBS_VTP_TAG=${GF_SBS_VTP_TAG:-0x56}
GF_SBS_MODE=${GF_SBS_MODE:-road}
GF_SBS_ROAD_SCALE=${GF_SBS_ROAD_SCALE:-1.0}

# ---- station / process -----------------------------------------------------------------
GF_BB_THREADS=${GF_BB_THREADS:-8}
GF_SBS_THREADS=${GF_SBS_THREADS:-8}
GF_PRESCALE=${GF_PRESCALE:-1000}        # every Nth physics event written raw (flagged)
GF_BLOCKING=${GF_BLOCKING:-1}           # 1 = blocking (never bypass); 0 = bypass when behind
GF_CUE=${GF_CUE:-200}                   # input cue for GF_BLOCKING=0
GF_RESTORE=${GF_RESTORE:-out}           # where ET sends events of a dead filter (out = to ER)
GF_STATS_S=${GF_STATS_S:-10}
GF_EXTRA_ARGS=${GF_EXTRA_ARGS:-}        # appended to every gemfilter_et command line

# ---- run control behaviour -------------------------------------------------------------
GF_ATTACH_WAIT_S=${GF_ATTACH_WAIT_S:-30} # prestart: wait this long for the stations to attach
GF_STRICT=${GF_STRICT:-0}               # 1 = hook exits non-zero if a filter is not in place
GF_STOP_ON_RESET=${GF_STOP_ON_RESET:-0} # 1 = stop the filters on Reset (default: keep running)

# ---- paths -----------------------------------------------------------------------------
GF_RUN_DIR=${GF_RUN_DIR:-/tmp/gemfilter_${GF_EXPID}}   # pid files, rendered configs
GF_LOG_DIR=${GF_LOG_DIR:-${GF_PREFIX:-.}/log}
